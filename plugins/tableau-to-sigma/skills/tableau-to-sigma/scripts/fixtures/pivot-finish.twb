<?xml version='1.0' encoding='utf-8' ?>
<!-- Synthetic fixture (invented names, no customer data) for crosstab finish
     and quick-filter scope:
     - "KPI Crosstab" puts Measure Names FIRST on Rows (before Region and Order
       Channel), a discrete date calc on Columns formatted '*m/d/yy' (Tableau's
       leading '*' = locale default marker), and hides the column field labels
       (display-field-labels scope=cols false).
     - "INFO Button - KPI" is a Shape-mark icon sheet whose only content is a
       customized tooltip (an information popup).
     - The dashboard's Order Channel and Region quick filters apply to SELECTED
       worksheets (filter-group), with no shared-view: Order Channel (group 3)
       reaches KPI Crosstab + Revenue by Region only; Region (group 4) reaches
       Revenue by Channel only. -->
<workbook locale='en_US' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource caption='Orders' inline='true' name='federated.pivfin0001' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='wh' name='snowflake.pivfin0001'>
            <connection class='snowflake' dbname='ANALYTICS' schema='SALES' server='warehouse.example.com' />
          </named-connection>
        </named-connections>
        <relation connection='snowflake.pivfin0001' name='ORDERS' table='[SALES].[ORDERS]' type='table' />
      </connection>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal' />
      <column caption='Order Date' datatype='date' name='[ORDER_DATE]' role='dimension' type='ordinal' />
      <column caption='Order Channel' datatype='string' name='[ORDER_CHANNEL]' role='dimension' type='nominal' />
      <column caption='Region' datatype='string' name='[REGION]' role='dimension' type='nominal' />
      <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
      <column caption='Gross Revenue' datatype='real' name='[GROSS_REVENUE]' role='measure' type='quantitative' />
      <column caption='Net Profit' datatype='real' name='[NET_PROFIT]' role='measure' type='quantitative' />
      <column caption='Week Start' datatype='date' name='[Calculation_201]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [ORDER_DATE])' />
      </column>
      <column caption='Profit Ratio' datatype='real' default-format='p0.00%' name='[Calculation_202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([NET_PROFIT]) / SUM([NET_REVENUE])' />
      </column>
      <column caption='info' datatype='string' name='[Calculation_203]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;i&quot;' />
      </column>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='KPI Crosstab'>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders' name='federated.pivfin0001' />
          </datasources>
          <datasource-dependencies datasource='federated.pivfin0001'>
            <column caption='Week Start' datatype='date' name='[Calculation_201]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [ORDER_DATE])' />
            </column>
            <column caption='Profit Ratio' datatype='real' default-format='p0.00%' name='[Calculation_202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([NET_PROFIT]) / SUM([NET_REVENUE])' />
            </column>
            <column caption='Gross Revenue' datatype='real' name='[GROSS_REVENUE]' role='measure' type='quantitative' />
            <column caption='Net Profit' datatype='real' name='[NET_PROFIT]' role='measure' type='quantitative' />
            <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
            <column caption='Order Channel' datatype='string' name='[ORDER_CHANNEL]' role='dimension' type='nominal' />
            <column caption='Order Date' datatype='date' name='[ORDER_DATE]' role='dimension' type='ordinal' />
            <column caption='Region' datatype='string' name='[REGION]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_201]' derivation='None' name='[none:Calculation_201:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_202]' derivation='User' name='[usr:Calculation_202:qk]' pivot='key' type='quantitative' />
            <column-instance column='[GROSS_REVENUE]' derivation='Sum' name='[sum:GROSS_REVENUE:qk]' pivot='key' type='quantitative' />
            <column-instance column='[NET_REVENUE]' derivation='Sum' name='[sum:NET_REVENUE:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ORDER_CHANNEL]' derivation='None' name='[none:ORDER_CHANNEL:nk]' pivot='key' type='nominal' />
            <column-instance column='[REGION]' derivation='None' name='[none:REGION:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.pivfin0001].[:Measure Names]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.pivfin0001].[sum:NET_REVENUE:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.pivfin0001].[sum:GROSS_REVENUE:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.pivfin0001].[usr:Calculation_202:qk]&quot;' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.pivfin0001].[none:ORDER_CHANNEL:nk]' filter-group='3'>
            <groupfilter function='level-members' level='[none:ORDER_CHANNEL:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.pivfin0001].[:Measure Names]</column>
            <column>[federated.pivfin0001].[none:ORDER_CHANNEL:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='label'>
            <format attr='text-format' field='[federated.pivfin0001].[none:Calculation_201:ok]' value='*m/d/yy' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.pivfin0001].[Multiple Values]' />
            </encodings>
          </pane>
        </panes>
        <rows>([federated.pivfin0001].[:Measure Names] / ([federated.pivfin0001].[none:REGION:nk] / [federated.pivfin0001].[none:ORDER_CHANNEL:nk]))</rows>
        <cols>[federated.pivfin0001].[none:Calculation_201:ok]</cols>
      </table>
    </worksheet>
    <worksheet name='Revenue by Region'>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders' name='federated.pivfin0001' />
          </datasources>
          <datasource-dependencies datasource='federated.pivfin0001'>
            <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
            <column caption='Order Channel' datatype='string' name='[ORDER_CHANNEL]' role='dimension' type='nominal' />
            <column caption='Region' datatype='string' name='[REGION]' role='dimension' type='nominal' />
            <column-instance column='[NET_REVENUE]' derivation='Sum' name='[sum:NET_REVENUE:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ORDER_CHANNEL]' derivation='None' name='[none:ORDER_CHANNEL:nk]' pivot='key' type='nominal' />
            <column-instance column='[REGION]' derivation='None' name='[none:REGION:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.pivfin0001].[none:ORDER_CHANNEL:nk]' filter-group='3'>
            <groupfilter function='level-members' level='[none:ORDER_CHANNEL:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.pivfin0001].[none:ORDER_CHANNEL:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.pivfin0001].[none:REGION:nk]</rows>
        <cols>[federated.pivfin0001].[sum:NET_REVENUE:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Revenue by Channel'>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders' name='federated.pivfin0001' />
          </datasources>
          <datasource-dependencies datasource='federated.pivfin0001'>
            <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
            <column caption='Order Channel' datatype='string' name='[ORDER_CHANNEL]' role='dimension' type='nominal' />
            <column caption='Region' datatype='string' name='[REGION]' role='dimension' type='nominal' />
            <column-instance column='[NET_REVENUE]' derivation='Sum' name='[sum:NET_REVENUE:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ORDER_CHANNEL]' derivation='None' name='[none:ORDER_CHANNEL:nk]' pivot='key' type='nominal' />
            <column-instance column='[REGION]' derivation='None' name='[none:REGION:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.pivfin0001].[none:REGION:nk]' filter-group='4'>
            <groupfilter function='level-members' level='[none:REGION:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.pivfin0001].[none:REGION:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.pivfin0001].[none:ORDER_CHANNEL:nk]</rows>
        <cols>[federated.pivfin0001].[sum:NET_REVENUE:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='INFO Button - KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders' name='federated.pivfin0001' />
          </datasources>
          <datasource-dependencies datasource='federated.pivfin0001'>
            <column caption='info' datatype='string' name='[Calculation_203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;i&quot;' />
            </column>
            <column-instance column='[Calculation_203]' derivation='Attribute' name='[attr:Calculation_203:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-disallow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Shape' />
            <encodings>
              <tooltip column='[federated.pivfin0001].[attr:Calculation_203:nk]' />
            </encodings>
            <customized-tooltip show-buttons='false'>
              <formatted-text>
                <run bold='true' fontcolor='#1f4e79'>Shows weekly revenue and margin by region and order channel.</run>
                <run>Æ&#10;Æ&#10;</run>
                <run bold='true'>Key questions:</run>
                <run>Æ&#10;</run>
                <run>- Which channels grow week over week?</run>
                <run>Æ&#10;</run>
                <run>- Where is margin slipping?</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='KPI Deep Dive'>
      <size maxheight='900' maxwidth='1400' minheight='900' minwidth='1400' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='2' param='horz' type-v2='layout-flow' w='100000' x='0' y='0'>
            <zone h='100000' id='3' param='vert' type-v2='layout-flow' w='18000' x='0' y='0'>
              <zone h='8000' id='10' mode='checkdropdown' name='KPI Crosstab' param='[federated.pivfin0001].[none:ORDER_CHANNEL:nk]' type-v2='filter' values='relevant' w='18000' x='0' y='0' />
              <zone h='8000' id='11' mode='checkdropdown' name='Revenue by Channel' param='[federated.pivfin0001].[none:REGION:nk]' type-v2='filter' values='relevant' w='18000' x='0' y='8000' />
            </zone>
            <zone h='100000' id='4' param='vert' type-v2='layout-flow' w='82000' x='18000' y='0'>
              <zone h='4000' id='20' name='INFO Button - KPI' show-title='false' w='3000' x='97000' y='0' />
              <zone h='56000' id='21' name='KPI Crosstab' w='82000' x='18000' y='4000' />
              <zone h='40000' id='22' name='Revenue by Region' w='41000' x='18000' y='60000' />
              <zone h='40000' id='23' name='Revenue by Channel' w='41000' x='59000' y='60000' />
            </zone>
          </zone>
        </zone>
      </zones>
    </dashboard>
  </dashboards>
</workbook>
