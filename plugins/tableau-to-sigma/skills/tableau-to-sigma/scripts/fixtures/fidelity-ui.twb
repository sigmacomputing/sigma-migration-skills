<?xml version='1.0' encoding='utf-8' ?>
<!-- Synthetic fixture (invented names, no customer data) for the presentation-fidelity
     fixes found by a live comparison of migrated workbooks against their sources:
     - the DATASOURCE carries the member->color maps (Edit Colors / field default
       properties): Category (Apparel blue, Electronics orange, Home GREEN - not the
       default alphabetical palette) and a boolean "Low Margin" flag (true red,
       false green). "Category Bar" colors by Category; "Top Bar" shows only two of
       the three members.
     - "Store Rank" is a crosstab sorted by Net Revenue (a measure it does NOT show),
       limited to the top 3 stores, with a Measure Names filter that lists only
       Margin % and Orders, and the Low Margin flag on its Color shelf (text color).
     - "Return Heat" is a Square-mark crosstab colored by the built-in named ramp
       palette='orange_10_0' (not serialized in the workbook).
     - "YoY Growth" puts YEAR(Order Date) on Columns.
     - "Days Bar" carries a bounded in-range quick filter on Days To Ship. -->
<workbook locale='en_US' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource caption='Orders' inline='true' name='federated.fidui0001' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='wh' name='snowflake.fidui0001'>
            <connection class='snowflake' dbname='SALESDB' schema='DEMO' server='warehouse.example.com' />
          </named-connection>
        </named-connections>
        <relation connection='snowflake.fidui0001' name='ORDERS' table='[DEMO].[ORDERS]' type='table' />
      </connection>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal' />
      <column caption='Category' datatype='string' name='[CATEGORY]' role='dimension' type='nominal' />
      <column caption='Store Name' datatype='string' name='[STORE_NAME]' role='dimension' type='nominal' />
      <column caption='Store Type' datatype='string' name='[STORE_TYPE]' role='dimension' type='nominal' />
      <column caption='Ship Method' datatype='string' name='[SHIP_METHOD]' role='dimension' type='nominal' />
      <column caption='Order Id' datatype='string' name='[ORDER_ID]' role='dimension' type='nominal' />
      <column caption='Order Date' datatype='date' name='[ORDER_DATE]' role='dimension' type='ordinal' />
      <column caption='Days To Ship' datatype='integer' name='[DAYS_TO_SHIP]' role='measure' type='quantitative' />
      <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
      <column caption='Gross Profit' datatype='real' name='[GROSS_PROFIT]' role='measure' type='quantitative' />
      <column caption='Low Margin Flag' datatype='boolean' name='[Calculation_901]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([GROSS_PROFIT]) / SUM([NET_REVENUE]) &lt; 0.66' />
      </column>
      <column caption='Margin %' datatype='real' default-format='p0.0%' name='[Calculation_902]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([GROSS_PROFIT]) / SUM([NET_REVENUE])' />
      </column>
      <column caption='Orders' datatype='integer' default-format='n#,##0' name='[Calculation_903]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([ORDER_ID])' />
      </column>
      <column caption='YoY Growth %' datatype='real' name='[Calculation_904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([NET_REVENUE])) - LOOKUP(ZN(SUM([NET_REVENUE])), -1)) / ABS(LOOKUP(ZN(SUM([NET_REVENUE])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:CATEGORY:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;Apparel&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;Electronics&quot;</bucket>
            </map>
            <map to='#59a14f'>
              <bucket>&quot;Home&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[usr:Calculation_901:nk]' type='palette'>
            <map to='#d1495b'>
              <bucket>true</bucket>
            </map>
            <map to='#1b5e20'>
              <bucket>false</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Category Bar'>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders' name='federated.fidui0001' />
          </datasources>
          <datasource-dependencies datasource='federated.fidui0001'>
            <column caption='Category' datatype='string' name='[CATEGORY]' role='dimension' type='nominal' />
            <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
            <column-instance column='[CATEGORY]' derivation='None' name='[none:CATEGORY:nk]' pivot='key' type='nominal' />
            <column-instance column='[NET_REVENUE]' derivation='Sum' name='[sum:NET_REVENUE:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <computed-sort column='[federated.fidui0001].[none:CATEGORY:nk]' direction='DESC' using='[federated.fidui0001].[sum:NET_REVENUE:qk]' />
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.fidui0001].[none:CATEGORY:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.fidui0001].[none:CATEGORY:nk]</rows>
        <cols>[federated.fidui0001].[sum:NET_REVENUE:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Top Bar'>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders' name='federated.fidui0001' />
          </datasources>
          <datasource-dependencies datasource='federated.fidui0001'>
            <column caption='Category' datatype='string' name='[CATEGORY]' role='dimension' type='nominal' />
            <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
            <column-instance column='[CATEGORY]' derivation='None' name='[none:CATEGORY:nk]' pivot='key' type='nominal' />
            <column-instance column='[NET_REVENUE]' derivation='Sum' name='[sum:NET_REVENUE:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <computed-sort column='[federated.fidui0001].[none:CATEGORY:nk]' direction='DESC' using='[federated.fidui0001].[sum:NET_REVENUE:qk]' />
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.fidui0001].[none:CATEGORY:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.fidui0001].[none:CATEGORY:nk]</rows>
        <cols>[federated.fidui0001].[sum:NET_REVENUE:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Store Rank'>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders' name='federated.fidui0001' />
          </datasources>
          <datasource-dependencies datasource='federated.fidui0001'>
            <column caption='Store Name' datatype='string' name='[STORE_NAME]' role='dimension' type='nominal' />
            <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
            <column caption='Gross Profit' datatype='real' name='[GROSS_PROFIT]' role='measure' type='quantitative' />
            <column caption='Order Id' datatype='string' name='[ORDER_ID]' role='dimension' type='nominal' />
            <column caption='Low Margin Flag' datatype='boolean' name='[Calculation_901]' role='measure' type='nominal'>
              <calculation class='tableau' formula='SUM([GROSS_PROFIT]) / SUM([NET_REVENUE]) &lt; 0.66' />
            </column>
            <column caption='Margin %' datatype='real' default-format='p0.0%' name='[Calculation_902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GROSS_PROFIT]) / SUM([NET_REVENUE])' />
            </column>
            <column caption='Orders' datatype='integer' default-format='n#,##0' name='[Calculation_903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([ORDER_ID])' />
            </column>
            <column-instance column='[STORE_NAME]' derivation='None' name='[none:STORE_NAME:nk]' pivot='key' type='nominal' />
            <column-instance column='[NET_REVENUE]' derivation='Sum' name='[sum:NET_REVENUE:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_901]' derivation='User' name='[usr:Calculation_901:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_902]' derivation='User' name='[usr:Calculation_902:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_903]' derivation='User' name='[usr:Calculation_903:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.fidui0001].[none:STORE_NAME:nk]'>
            <groupfilter count='3' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([NET_REVENUE])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:STORE_NAME:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.fidui0001].[:Measure Names]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.fidui0001].[usr:Calculation_902:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.fidui0001].[usr:Calculation_903:qk]&quot;' />
            </groupfilter>
          </filter>
          <computed-sort column='[federated.fidui0001].[none:STORE_NAME:nk]' direction='DESC' using='[federated.fidui0001].[sum:NET_REVENUE:qk]' />
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[federated.fidui0001].[usr:Calculation_901:nk]' />
              <text column='[federated.fidui0001].[Multiple Values]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.fidui0001].[none:STORE_NAME:nk]</rows>
        <cols>[federated.fidui0001].[:Measure Names]</cols>
      </table>
    </worksheet>
    <worksheet name='Return Heat'>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders' name='federated.fidui0001' />
          </datasources>
          <datasource-dependencies datasource='federated.fidui0001'>
            <column caption='Store Type' datatype='string' name='[STORE_TYPE]' role='dimension' type='nominal' />
            <column caption='Ship Method' datatype='string' name='[SHIP_METHOD]' role='dimension' type='nominal' />
            <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
            <column-instance column='[STORE_TYPE]' derivation='None' name='[none:STORE_TYPE:nk]' pivot='key' type='nominal' />
            <column-instance column='[SHIP_METHOD]' derivation='None' name='[none:SHIP_METHOD:nk]' pivot='key' type='nominal' />
            <column-instance column='[NET_REVENUE]' derivation='Sum' name='[sum:NET_REVENUE:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.fidui0001].[sum:NET_REVENUE:qk]' palette='orange_10_0' type='interpolated' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Square' />
            <encodings>
              <color column='[federated.fidui0001].[sum:NET_REVENUE:qk]' />
              <text column='[federated.fidui0001].[sum:NET_REVENUE:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.fidui0001].[none:STORE_TYPE:nk]</rows>
        <cols>[federated.fidui0001].[none:SHIP_METHOD:nk]</cols>
      </table>
    </worksheet>
    <worksheet name='YoY Growth'>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders' name='federated.fidui0001' />
          </datasources>
          <datasource-dependencies datasource='federated.fidui0001'>
            <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
            <column caption='Order Date' datatype='date' name='[ORDER_DATE]' role='dimension' type='ordinal' />
            <column caption='YoY Growth %' datatype='real' name='[Calculation_904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([NET_REVENUE])) - LOOKUP(ZN(SUM([NET_REVENUE])), -1)) / ABS(LOOKUP(ZN(SUM([NET_REVENUE])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column-instance column='[ORDER_DATE]' derivation='Year' name='[yr:ORDER_DATE:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_904]' derivation='User' name='[usr:Calculation_904:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.fidui0001].[yr:ORDER_DATE:ok]' ordering-type='Field' />
            </column-instance>
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.fidui0001].[usr:Calculation_904:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols>[federated.fidui0001].[yr:ORDER_DATE:ok]</cols>
      </table>
    </worksheet>
    <worksheet name='Days Bar'>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders' name='federated.fidui0001' />
          </datasources>
          <datasource-dependencies datasource='federated.fidui0001'>
            <column caption='Store Type' datatype='string' name='[STORE_TYPE]' role='dimension' type='nominal' />
            <column caption='Days To Ship' datatype='integer' name='[DAYS_TO_SHIP]' role='measure' type='quantitative' />
            <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
            <column-instance column='[STORE_TYPE]' derivation='None' name='[none:STORE_TYPE:nk]' pivot='key' type='nominal' />
            <column-instance column='[DAYS_TO_SHIP]' derivation='None' name='[none:DAYS_TO_SHIP:qk]' pivot='key' type='quantitative' />
            <column-instance column='[NET_REVENUE]' derivation='Sum' name='[sum:NET_REVENUE:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.fidui0001].[none:DAYS_TO_SHIP:qk]' filter-group='1' included-values='in-range'>
            <min>0</min>
            <max>10</max>
          </filter>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.fidui0001].[none:STORE_TYPE:nk]</rows>
        <cols>[federated.fidui0001].[sum:NET_REVENUE:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Fidelity UI'>
      <size maxheight='900' maxwidth='1400' minheight='900' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource caption='Orders' name='federated.fidui0001' />
      </datasources>
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='2' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'>
            <zone h='16000' id='3' param='horz' type-v2='layout-flow' w='100000' x='0' y='0'>
              <zone h='16000' id='10' mode='slider' name='Days Bar' param='[federated.fidui0001].[none:DAYS_TO_SHIP:qk]' type-v2='filter' w='20000' x='0' y='0' />
              <zone h='16000' id='21' name='Category Bar' w='40000' x='20000' y='0' />
              <zone h='16000' id='22' name='Top Bar' w='40000' x='60000' y='0' />
            </zone>
            <zone h='28000' id='4' param='horz' type-v2='layout-flow' w='100000' x='0' y='16000'>
              <zone h='28000' id='23' name='Store Rank' w='50000' x='0' y='16000' />
              <zone h='28000' id='24' name='Return Heat' w='50000' x='50000' y='16000' />
            </zone>
            <zone h='28000' id='5' param='horz' type-v2='layout-flow' w='100000' x='0' y='44000'>
              <zone h='28000' id='25' name='YoY Growth' w='50000' x='0' y='44000' />
              <zone h='28000' id='26' name='Days Bar' w='50000' x='50000' y='44000' />
            </zone>
          </zone>
        </zone>
      </zones>
    </dashboard>
  </dashboards>
</workbook>
