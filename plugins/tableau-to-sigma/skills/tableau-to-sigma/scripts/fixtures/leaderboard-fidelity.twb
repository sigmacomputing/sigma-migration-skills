<?xml version='1.0' encoding='utf-8' ?>
<!-- Synthetic fixture (invented names, no customer data) for the sales-leaderboard gaps a live
     migration exposed:
     - 'Store Leaderboard Mo': a bar of the parameter-switched measure whose Text (Label) shelf carries
       RANK(SUM([Volume Measure - Mo])) — the rank label.
     - 'Rank Table Yr': a Measure Names/Values text table (kind `table` once the dashboard PNG read is
       verified) of a rank, a dense rank, a share of total and the measure, the latter three over the
       "(copy)" duplicate of the measure. Tableau's CSV headers carry " along Table (Down)".
     - 'Store Lookup': a bar over a GROUP field filtered by a table-calc boolean search box
       (CONTAINS(LOOKUP(MAX(UPPER(<dim>)),0),UPPER(<text parameter>)) kept on true) with a rank label;
       a blank-search flag (0/1 calc over the parameter) rides the Color shelf.
     - 'X', 'X ', 'X  ': three decorative KPI sheets whose names differ only by trailing spaces. -->
<workbook locale='en_US' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <column caption='Units vs Volume' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Volume&quot;'>
        <calculation class='tableau' formula='&quot;Volume&quot;' />
        <members>
          <member value='&quot;Units&quot;' />
          <member value='&quot;Volume&quot;' />
        </members>
      </column>
      <column caption='Store Lookup' datatype='string' name='[Parameter 2]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
    </datasource>
    <datasource caption='Sales Leaderboards' inline='true' name='federated.lbfid0001' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='wh' name='snowflake.lbfid0001'>
            <connection class='snowflake' dbname='SALESDB' schema='DEMO' server='warehouse.example.com' />
          </named-connection>
        </named-connections>
        <relation connection='snowflake.lbfid0001' name='ORDER_FACT' table='[DEMO].[ORDER_FACT]' type='table' />
      </connection>
      <column caption='Store Name' datatype='string' name='[STORE_NAME]' role='dimension' type='nominal' />
      <column caption='Quantity Ordered' datatype='integer' name='[QUANTITY_ORDERED]' role='measure' type='quantitative' />
      <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
      <column caption='Volume Measure - Mo' datatype='real' name='[Volume Measure - Mo]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Units&apos; THEN [QUANTITY_ORDERED] ELSE [NET_REVENUE] END' />
      </column>
      <column caption='Volume Measure - Yr' datatype='real' name='[Volume Measure - Mo (copy)_555]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Units&apos; THEN [QUANTITY_ORDERED] ELSE [NET_REVENUE] END' />
      </column>
      <column caption='Rank - Mo' datatype='integer' name='[Calculation_1001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Volume Measure - Mo]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank - Yr' datatype='integer' name='[Calculation_1002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Volume Measure - Mo (copy)_555]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dense Rank - Yr' datatype='integer' name='[Calculation_1003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE(SUM([Volume Measure - Mo (copy)_555]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Share of Total' datatype='real' default-format='p0.0%' name='[Calculation_1004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Volume Measure - Mo (copy)_555]) / WINDOW_SUM(SUM([Volume Measure - Mo (copy)_555]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Store Name (group)' datatype='string' name='[Store Name (group)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [STORE_NAME] IN (&quot;Harbor Flagship&quot;, &quot;Lakeside Standard&quot;) THEN &quot;East Team&quot; ELSEIF [STORE_NAME] IN (&quot;Summit Outlet&quot;, &quot;Canyon Kiosk&quot;) THEN &quot;West Team&quot; ELSE [STORE_NAME] END' />
      </column>
      <column caption='Store Rank Search' datatype='boolean' name='[Calculation_1005]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CONTAINS(LOOKUP(MAX(UPPER([Store Name (group)])),0),UPPER([Parameters].[Parameter 2]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Blank Lookup' datatype='integer' name='[Calculation_1006]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF ISNULL([Parameters].[Parameter 2]) OR [Parameters].[Parameter 2] = &apos;&apos; THEN 0 ELSE 1 END' />
      </column>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Store Leaderboard Mo'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Monthly Store Leaderboard</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales Leaderboards' name='federated.lbfid0001' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='federated.lbfid0001'>
            <column caption='Store Name' datatype='string' name='[STORE_NAME]' role='dimension' type='nominal' />
            <column caption='Quantity Ordered' datatype='integer' name='[QUANTITY_ORDERED]' role='measure' type='quantitative' />
            <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
            <column caption='Rank - Mo' datatype='integer' name='[Calculation_1001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK(SUM([Volume Measure - Mo]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Volume Measure - Mo' datatype='real' name='[Volume Measure - Mo]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Units&apos; THEN [QUANTITY_ORDERED] ELSE [NET_REVENUE] END' />
            </column>
            <column-instance column='[STORE_NAME]' derivation='None' name='[none:STORE_NAME:nk]' pivot='key' type='nominal' />
            <column-instance column='[Volume Measure - Mo]' derivation='Sum' name='[sum:Volume Measure - Mo:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1001]' derivation='User' name='[usr:Calculation_1001:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
            </column-instance>
          </datasource-dependencies>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Units vs Volume' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Volume&quot;'>
              <calculation class='tableau' formula='&quot;Volume&quot;' />
              <members>
                <member value='&quot;Units&quot;' />
                <member value='&quot;Volume&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <computed-sort column='[federated.lbfid0001].[none:STORE_NAME:nk]' direction='DESC' using='[federated.lbfid0001].[sum:Volume Measure - Mo:qk]' />
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <text column='[federated.lbfid0001].[usr:Calculation_1001:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.lbfid0001].[none:STORE_NAME:nk]</rows>
        <cols>[federated.lbfid0001].[sum:Volume Measure - Mo:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Rank Table Yr'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Annual Rank Table</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales Leaderboards' name='federated.lbfid0001' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='federated.lbfid0001'>
            <column caption='Store Name' datatype='string' name='[STORE_NAME]' role='dimension' type='nominal' />
            <column caption='Quantity Ordered' datatype='integer' name='[QUANTITY_ORDERED]' role='measure' type='quantitative' />
            <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
            <column caption='Dense Rank - Yr' datatype='integer' name='[Calculation_1003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_DENSE(SUM([Volume Measure - Mo (copy)_555]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Rank - Yr' datatype='integer' name='[Calculation_1002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK(SUM([Volume Measure - Mo (copy)_555]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Share of Total' datatype='real' default-format='p0.0%' name='[Calculation_1004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Volume Measure - Mo (copy)_555]) / WINDOW_SUM(SUM([Volume Measure - Mo (copy)_555]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Volume Measure - Yr' datatype='real' name='[Volume Measure - Mo (copy)_555]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Units&apos; THEN [QUANTITY_ORDERED] ELSE [NET_REVENUE] END' />
            </column>
            <column-instance column='[STORE_NAME]' derivation='None' name='[none:STORE_NAME:nk]' pivot='key' type='nominal' />
            <column-instance column='[Volume Measure - Mo (copy)_555]' derivation='Sum' name='[sum:Volume Measure - Mo (copy)_555:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1002]' derivation='User' name='[usr:Calculation_1002:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
            </column-instance>
            <column-instance column='[Calculation_1003]' derivation='User' name='[usr:Calculation_1003:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
            </column-instance>
            <column-instance column='[Calculation_1004]' derivation='User' name='[usr:Calculation_1004:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
            </column-instance>
          </datasource-dependencies>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Units vs Volume' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Volume&quot;'>
              <calculation class='tableau' formula='&quot;Volume&quot;' />
              <members>
                <member value='&quot;Units&quot;' />
                <member value='&quot;Volume&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.lbfid0001].[:Measure Names]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.lbfid0001].[sum:Volume Measure - Mo (copy)_555:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.lbfid0001].[usr:Calculation_1002:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.lbfid0001].[usr:Calculation_1003:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.lbfid0001].[usr:Calculation_1004:qk]&quot;' />
            </groupfilter>
          </filter>
          <computed-sort column='[federated.lbfid0001].[none:STORE_NAME:nk]' direction='DESC' using='[federated.lbfid0001].[sum:Volume Measure - Mo (copy)_555:qk]' />
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.lbfid0001].[Multiple Values]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.lbfid0001].[none:STORE_NAME:nk]</rows>
        <cols>[federated.lbfid0001].[:Measure Names]</cols>
      </table>
    </worksheet>
    <worksheet name='Store Lookup'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Store Lookup (search the group by name)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales Leaderboards' name='federated.lbfid0001' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='federated.lbfid0001'>
            <column caption='Store Name' datatype='string' name='[STORE_NAME]' role='dimension' type='nominal' />
            <column caption='Quantity Ordered' datatype='integer' name='[QUANTITY_ORDERED]' role='measure' type='quantitative' />
            <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
            <column caption='Blank Lookup' datatype='integer' name='[Calculation_1006]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF ISNULL([Parameters].[Parameter 2]) OR [Parameters].[Parameter 2] = &apos;&apos; THEN 0 ELSE 1 END' />
            </column>
            <column caption='Rank - Mo' datatype='integer' name='[Calculation_1001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK(SUM([Volume Measure - Mo]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Store Name (group)' datatype='string' name='[Store Name (group)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [STORE_NAME] IN (&quot;Harbor Flagship&quot;, &quot;Lakeside Standard&quot;) THEN &quot;East Team&quot; ELSEIF [STORE_NAME] IN (&quot;Summit Outlet&quot;, &quot;Canyon Kiosk&quot;) THEN &quot;West Team&quot; ELSE [STORE_NAME] END' />
            </column>
            <column caption='Store Rank Search' datatype='boolean' name='[Calculation_1005]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CONTAINS(LOOKUP(MAX(UPPER([Store Name (group)])),0),UPPER([Parameters].[Parameter 2]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Volume Measure - Mo' datatype='real' name='[Volume Measure - Mo]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Units&apos; THEN [QUANTITY_ORDERED] ELSE [NET_REVENUE] END' />
            </column>
            <column-instance column='[Calculation_1006]' derivation='None' name='[none:Calculation_1006:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Store Name (group)]' derivation='None' name='[none:Store Name (group):nk]' pivot='key' type='nominal' />
            <column-instance column='[Volume Measure - Mo]' derivation='Sum' name='[sum:Volume Measure - Mo:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1001]' derivation='User' name='[usr:Calculation_1001:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
            </column-instance>
            <column-instance column='[Calculation_1005]' derivation='User' name='[usr:Calculation_1005:nk]' pivot='key' type='nominal'>
              <table-calc ordering-type='Columns' />
            </column-instance>
          </datasource-dependencies>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Units vs Volume' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Volume&quot;'>
              <calculation class='tableau' formula='&quot;Volume&quot;' />
              <members>
                <member value='&quot;Units&quot;' />
                <member value='&quot;Volume&quot;' />
              </members>
            </column>
            <column caption='Store Lookup' datatype='string' name='[Parameter 2]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.lbfid0001].[usr:Calculation_1005:nk]'>
            <groupfilter function='member' level='[usr:Calculation_1005:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <computed-sort column='[federated.lbfid0001].[none:Store Name (group):nk]' direction='DESC' using='[federated.lbfid0001].[sum:Volume Measure - Mo:qk]' />
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.lbfid0001].[none:Calculation_1006:ok]' />
              <text column='[federated.lbfid0001].[usr:Calculation_1001:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.lbfid0001].[none:Store Name (group):nk]</rows>
        <cols>[federated.lbfid0001].[sum:Volume Measure - Mo:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='X'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Net Revenue</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales Leaderboards' name='federated.lbfid0001' />
          </datasources>
          <datasource-dependencies datasource='federated.lbfid0001'>
            <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
            <column-instance column='[NET_REVENUE]' derivation='Sum' name='[sum:NET_REVENUE:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.lbfid0001].[sum:NET_REVENUE:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
    <worksheet name='X '>
      <layout-options>
        <title>
          <formatted-text>
            <run>Units</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales Leaderboards' name='federated.lbfid0001' />
          </datasources>
          <datasource-dependencies datasource='federated.lbfid0001'>
            <column caption='Quantity Ordered' datatype='integer' name='[QUANTITY_ORDERED]' role='measure' type='quantitative' />
            <column-instance column='[QUANTITY_ORDERED]' derivation='Sum' name='[sum:QUANTITY_ORDERED:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.lbfid0001].[sum:QUANTITY_ORDERED:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
    <worksheet name='X  '>
      <layout-options>
        <title>
          <formatted-text>
            <run>Orders</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales Leaderboards' name='federated.lbfid0001' />
          </datasources>
          <datasource-dependencies datasource='federated.lbfid0001'>
            <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
            <column-instance column='[NET_REVENUE]' derivation='Avg' name='[avg:NET_REVENUE:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.lbfid0001].[avg:NET_REVENUE:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Monthly Board'>
      <size maxheight='900' maxwidth='1400' minheight='900' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource caption='Sales Leaderboards' name='federated.lbfid0001' />
        <datasource caption='Parameters' name='Parameters' />
      </datasources>
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='2' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'>
            <zone h='12000' id='10' mode='compact' param='[Parameters].[Parameter 1]' type-v2='paramctrl' w='30000' x='0' y='0' />
            <zone h='12000' id='11' mode='type_in' param='[Parameters].[Parameter 2]' type-v2='paramctrl' w='30000' x='30000' y='0' />
            <zone h='12000' id='18' name='X' w='13000' x='60000' y='0' />
            <zone h='12000' id='19' name='X ' w='13000' x='73000' y='0' />
            <zone h='12000' id='20' name='X  ' w='14000' x='86000' y='0' />
            <zone h='44000' id='23' name='Store Leaderboard Mo' w='50000' x='0' y='12000' />
            <zone h='44000' id='24' name='Store Lookup' w='50000' x='50000' y='12000' />
            <zone h='44000' id='26' name='Rank Table Yr' w='100000' x='0' y='56000' />
          </zone>
        </zone>
      </zones>
    </dashboard>
    <dashboard name='Annual Board'>
      <size maxheight='900' maxwidth='1400' minheight='900' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource caption='Sales Leaderboards' name='federated.lbfid0001' />
        <datasource caption='Parameters' name='Parameters' />
      </datasources>
      <zones>
        <zone h='100000' id='31' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='32' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'>
            <zone h='12000' id='40' mode='compact' param='[Parameters].[Parameter 1]' type-v2='paramctrl' w='30000' x='0' y='0' />
            <zone h='12000' id='41' mode='type_in' param='[Parameters].[Parameter 2]' type-v2='paramctrl' w='30000' x='30000' y='0' />
            <zone h='12000' id='48' name='X' w='13000' x='60000' y='0' />
            <zone h='12000' id='49' name='X ' w='13000' x='73000' y='0' />
            <zone h='12000' id='50' name='X  ' w='14000' x='86000' y='0' />
            <zone h='88000' id='53' name='Store Lookup' w='100000' x='0' y='12000' />
