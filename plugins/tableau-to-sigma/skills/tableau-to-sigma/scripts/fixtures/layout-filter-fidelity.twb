<?xml version='1.0' encoding='utf-8' ?>
<!-- Synthetic fixture (invented names, no customer data) for two dashboard-fidelity gaps a live
     migration exposed:
     - a quick filter (filter-group 1, a dashboard filter zone) on a CALCULATED dimension whose NAME ends
       in "(group)": [Store Name (group)] is a class='tableau' IF/IN calc, not a categorical-bin group.
       The converter used to skip every "(group)"-suffixed field, so the calc had no DM/master column and
       the quick filter no control.
     - 'Rank Table Yr': a Measure Names/Values text table whose zone is tall enough to show all 15 stores;
       Sigma clipped it (8 rows + a partial one + a SUMMARY footer).
     - 'Team Board': a bar over the calc dimension, filtered by the same quick filter. -->
<workbook locale='en_US' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <column caption='Units vs Volume' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Volume&quot;'>
        <calculation class='tableau' formula='&quot;Volume&quot;' />
        <members>
          <member value='&quot;Units&quot;' />
          <member value='&quot;Volume&quot;' />
        </members>
      </column>
      <column caption='Store Lookup' datatype='string' name='[Parameter 2]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
    </datasource>
    <datasource caption='Sales Leaderboards' inline='true' name='federated.lbfid0001' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='wh' name='snowflake.lbfid0001'>
            <connection class='snowflake' dbname='SALESDB' schema='DEMO' server='warehouse.example.com' />
          </named-connection>
        </named-connections>
        <relation connection='snowflake.lbfid0001' name='ORDER_FACT' table='[DEMO].[ORDER_FACT]' type='table' />
      </connection>
      <column caption='Store Name' datatype='string' name='[STORE_NAME]' role='dimension' type='nominal' />
      <column caption='Quantity Ordered' datatype='integer' name='[QUANTITY_ORDERED]' role='measure' type='quantitative' />
      <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
      <column caption='Volume Measure - Mo' datatype='real' name='[Volume Measure - Mo]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Units&apos; THEN [QUANTITY_ORDERED] ELSE [NET_REVENUE] END' />
      </column>
      <column caption='Volume Measure - Yr' datatype='real' name='[Volume Measure - Mo (copy)_555]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Units&apos; THEN [QUANTITY_ORDERED] ELSE [NET_REVENUE] END' />
      </column>
      <column caption='Rank - Mo' datatype='integer' name='[Calculation_1001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Volume Measure - Mo]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank - Yr' datatype='integer' name='[Calculation_1002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Volume Measure - Mo (copy)_555]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dense Rank - Yr' datatype='integer' name='[Calculation_1003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE(SUM([Volume Measure - Mo (copy)_555]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Share of Total' datatype='real' default-format='p0.0%' name='[Calculation_1004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Volume Measure - Mo (copy)_555]) / WINDOW_SUM(SUM([Volume Measure - Mo (copy)_555]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Store Name (group)' datatype='string' name='[Store Name (group)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [STORE_NAME] IN (&quot;Harbor Flagship&quot;, &quot;Lakeside Standard&quot;) THEN &quot;East Team&quot; ELSEIF [STORE_NAME] IN (&quot;Summit Outlet&quot;, &quot;Canyon Kiosk&quot;) THEN &quot;West Team&quot; ELSE [STORE_NAME] END' />
      </column>
      <column caption='Store Rank Search' datatype='boolean' name='[Calculation_1005]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CONTAINS(LOOKUP(MAX(UPPER([Store Name (group)])),0),UPPER([Parameters].[Parameter 2]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Blank Lookup' datatype='integer' name='[Calculation_1006]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF ISNULL([Parameters].[Parameter 2]) OR [Parameters].[Parameter 2] = &apos;&apos; THEN 0 ELSE 1 END' />
      </column>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Rank Table Yr'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Rank Table</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales Leaderboards' name='federated.lbfid0001' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='federated.lbfid0001'>
            <column caption='Store Name' datatype='string' name='[STORE_NAME]' role='dimension' type='nominal' />
            <column caption='Quantity Ordered' datatype='integer' name='[QUANTITY_ORDERED]' role='measure' type='quantitative' />
            <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
            <column caption='Dense Rank - Yr' datatype='integer' name='[Calculation_1003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_DENSE(SUM([Volume Measure - Mo (copy)_555]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Rank - Yr' datatype='integer' name='[Calculation_1002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK(SUM([Volume Measure - Mo (copy)_555]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Share of Total' datatype='real' default-format='p0.0%' name='[Calculation_1004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Volume Measure - Mo (copy)_555]) / WINDOW_SUM(SUM([Volume Measure - Mo (copy)_555]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Volume Measure - Yr' datatype='real' name='[Volume Measure - Mo (copy)_555]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Units&apos; THEN [QUANTITY_ORDERED] ELSE [NET_REVENUE] END' />
            </column>
            <column caption='Store Name (group)' datatype='string' name='[Store Name (group)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [STORE_NAME] IN (&quot;Harbor Flagship&quot;, &quot;Lakeside Standard&quot;) THEN &quot;East Team&quot; ELSEIF [STORE_NAME] IN (&quot;Summit Outlet&quot;, &quot;Canyon Kiosk&quot;) THEN &quot;West Team&quot; ELSE [STORE_NAME] END' />
            </column>
            <column-instance column='[STORE_NAME]' derivation='None' name='[none:STORE_NAME:nk]' pivot='key' type='nominal' />
            <column-instance column='[Store Name (group)]' derivation='None' name='[none:Store Name (group):nk]' pivot='key' type='nominal' />
            <column-instance column='[Volume Measure - Mo (copy)_555]' derivation='Sum' name='[sum:Volume Measure - Mo (copy)_555:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1002]' derivation='User' name='[usr:Calculation_1002:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
            </column-instance>
            <column-instance column='[Calculation_1003]' derivation='User' name='[usr:Calculation_1003:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
            </column-instance>
            <column-instance column='[Calculation_1004]' derivation='User' name='[usr:Calculation_1004:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
            </column-instance>
          </datasource-dependencies>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Units vs Volume' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Volume&quot;'>
              <calculation class='tableau' formula='&quot;Volume&quot;' />
              <members>
                <member value='&quot;Units&quot;' />
                <member value='&quot;Volume&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.lbfid0001].[:Measure Names]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.lbfid0001].[sum:Volume Measure - Mo (copy)_555:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.lbfid0001].[usr:Calculation_1002:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.lbfid0001].[usr:Calculation_1003:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.lbfid0001].[usr:Calculation_1004:qk]&quot;' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.lbfid0001].[none:Store Name (group):nk]' filter-group='1'>
            <groupfilter function='level-members' level='[none:Store Name (group):nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <computed-sort column='[federated.lbfid0001].[none:STORE_NAME:nk]' direction='DESC' using='[federated.lbfid0001].[sum:Volume Measure - Mo (copy)_555:qk]' />
          <slices>
            <column>[federated.lbfid0001].[none:Store Name (group):nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.lbfid0001].[Multiple Values]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.lbfid0001].[none:STORE_NAME:nk]</rows>
        <cols>[federated.lbfid0001].[:Measure Names]</cols>
      </table>
    </worksheet>
    <worksheet name='Team Board'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Team Board</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales Leaderboards' name='federated.lbfid0001' />
          </datasources>
          <datasource-dependencies datasource='federated.lbfid0001'>
            <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
            <column caption='Store Name (group)' datatype='string' name='[Store Name (group)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [STORE_NAME] IN (&quot;Harbor Flagship&quot;, &quot;Lakeside Standard&quot;) THEN &quot;East Team&quot; ELSEIF [STORE_NAME] IN (&quot;Summit Outlet&quot;, &quot;Canyon Kiosk&quot;) THEN &quot;West Team&quot; ELSE [STORE_NAME] END' />
            </column>
            <column-instance column='[Store Name (group)]' derivation='None' name='[none:Store Name (group):nk]' pivot='key' type='nominal' />
            <column-instance column='[NET_REVENUE]' derivation='Sum' name='[sum:NET_REVENUE:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.lbfid0001].[none:Store Name (group):nk]' filter-group='1'>
            <groupfilter function='level-members' level='[none:Store Name (group):nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.lbfid0001].[none:Store Name (group):nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.lbfid0001].[none:Store Name (group):nk]</rows>
        <cols>[federated.lbfid0001].[sum:NET_REVENUE:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Board'>
      <size maxheight='900' maxwidth='1400' minheight='900' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource caption='Sales Leaderboards' name='federated.lbfid0001' />
        <datasource caption='Parameters' name='Parameters' />
      </datasources>
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='2' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'>
            <zone h='14000' id='10' mode='compact' name='Team Board' param='[federated.lbfid0001].[none:Store Name (group):nk]' type-v2='filter' values='relevant' w='30000' x='0' y='0' />
            <zone h='14000' id='11' mode='compact' param='[Parameters].[Parameter 1]' type-v2='paramctrl' w='30000' x='30000' y='0' />
            <zone h='44000' id='23' name='Team Board' w='50000' x='0' y='14000' />
            <zone h='42000' id='26' name='Rank Table Yr' w='100000' x='0' y='58000' />
          </zone>
        </zone>
      </zones>
    </dashboard>
  </dashboards>
</workbook>
