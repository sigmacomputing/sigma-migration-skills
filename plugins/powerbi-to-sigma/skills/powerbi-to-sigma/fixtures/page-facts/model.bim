{
 "name": "Retail Fixture",
 "compatibilityLevel": 1550,
 "model": {
  "culture": "en-US",
  "tables": [
   {
    "name": "Sales",
    "columns": [
     {
      "name": "Sale Id",
      "dataType": "int64",
      "sourceColumn": "SALE_ID",
      "summarizeBy": "sum"
     },
     {
      "name": "Date Key",
      "dataType": "int64",
      "sourceColumn": "DATE_KEY",
      "summarizeBy": "none"
     },
     {
      "name": "Store Key",
      "dataType": "int64",
      "sourceColumn": "STORE_KEY",
      "summarizeBy": "none"
     },
     {
      "name": "Product Key",
      "dataType": "int64",
      "sourceColumn": "PRODUCT_KEY",
      "summarizeBy": "none"
     },
     {
      "name": "Qty",
      "dataType": "int64",
      "sourceColumn": "QTY",
      "summarizeBy": "sum"
     },
     {
      "name": "Amount",
      "dataType": "double",
      "sourceColumn": "AMOUNT",
      "summarizeBy": "sum"
     },
     {
      "name": "Cost",
      "dataType": "double",
      "sourceColumn": "COST",
      "summarizeBy": "sum"
     }
    ],
    "measures": [
     {
      "name": "Sales Amount",
      "expression": "SUM(Sales[Amount])",
      "formatString": "#,0.00"
     },
     {
      "name": "Sales Cost",
      "expression": "SUM(Sales[Cost])"
     },
     {
      "name": "Gross Margin",
      "expression": [
       "-- margin before rebates",
       "[Sales Amount] - [Sales Cost]"
      ]
     },
     {
      "name": "Margin %",
      "expression": "DIVIDE([Gross Margin], [Sales Amount])",
      "formatString": "0.0%"
     },
     {
      "name": "Units",
      "expression": "SUM(Sales[Qty])",
      "formatString": "#,0"
     },
     {
      "name": "Avg Price",
      "expression": "DIVIDE([Sales Amount], [Units])"
     },
     {
      "name": "West Sales",
      "expression": "CALCULATE([Sales Amount], Store[Region] = \"West\")"
     },
     {
      "name": "Orders",
      "expression": "DISTINCTCOUNT(Sales[Sale Id])",
      "formatString": "#,0"
     },
     {
      "name": "Prior Year Amount",
      "expression": "CALCULATE([Sales Amount], SAMEPERIODLASTYEAR(Calendar[Date]))"
     },
     {
      "name": "Rollup Sales",
      "expression": "CALCULATE([Sales Amount], USERELATIONSHIP(Rollup[Child Product Key], Sales[Product Key]))"
     },
     {
      "name": "Rollup Units",
      "expression": "CALCULATE([Units], USERELATIONSHIP(Rollup[Child Product Key], Sales[Product Key]))"
     },
     {
      "name": "Margin per Unit",
      "expression": [
       "VAR m = [Gross Margin]",
       "VAR u = [Units]",
       "RETURN DIVIDE(m, u)"
      ],
      "formatString": "0.00"
     }
    ],
    "partitions": [
     {
      "name": "Sales",
      "mode": "import",
      "source": {
       "type": "m",
       "expression": "let Source = Value.NativeQuery(Db, \"SELECT * FROM SALES\") in Source"
      }
     }
    ]
   },
   {
    "name": "Stock",
    "columns": [
     {
      "name": "Snapshot Date Key",
      "dataType": "int64",
      "sourceColumn": "SNAPSHOT_DATE_KEY",
      "summarizeBy": "none"
     },
     {
      "name": "Store Key",
      "dataType": "int64",
      "sourceColumn": "STORE_KEY",
      "summarizeBy": "none"
     },
     {
      "name": "Product Key",
      "dataType": "int64",
      "sourceColumn": "PRODUCT_KEY",
      "summarizeBy": "none"
     },
     {
      "name": "On Hand",
      "dataType": "int64",
      "sourceColumn": "ON_HAND",
      "summarizeBy": "sum"
     }
    ],
    "measures": [
     {
      "name": "On Hand",
      "expression": "SUM(Stock[On Hand])",
      "formatString": "#,0"
     },
     {
      "name": "Weeks of Cover",
      "expression": "DIVIDE([On Hand], [Units])",
      "formatString": "0.0"
     },
     {
      "name": "Unassigned Stock",
      "expression": "CALCULATE([On Hand], ISBLANK(Store[Manager Key]))",
      "formatString": "#,0"
     }
    ],
    "partitions": [
     {
      "name": "Stock",
      "mode": "import",
      "source": {
       "type": "m",
       "expression": "let Source = Value.NativeQuery(Db, \"SELECT * FROM STOCK\") in Source"
      }
     }
    ]
   },
   {
