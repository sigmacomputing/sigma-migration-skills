            "inode-AAAAAAAAAAAAAAAAAAAAAw/QUANTITY",
            "inode-AAAAAAAAAAAAAAAAAAAAAx/UNIT_PRICE",
            "inode-AAAAAAAAAAAAAAAAAAAAAy/DISCOUNT",
            "inode-AAAAAAAAAAAAAAAAAAAAAz/UNIT_COST"
          ],
          "metrics": [
            {
              "id": "AAAAAAAAA0",
              "formula": "Sum([Quantity] * [Unit Price] * (1 - [Discount]))",
              "name": "Sales Amount",
              "format": {
                "kind": "number",
                "formatString": ",.2f"
              }
            },
            {
              "id": "AAAAAAAAA1",
              "formula": "Sum([Quantity])",
              "name": "Units",
              "format": {
                "kind": "number",
                "formatString": ",.0f"
              }
            },
            {
              "id": "AAAAAAAAA2",
              "formula": "Sum([Quantity] * [Unit Cost])",
              "name": "Cost",
              "format": {
                "kind": "number",
                "formatString": ",.2f"
              }
            },
            {
              "id": "AAAAAAAAA3",
              "formula": "[Sales Amount] - [Cost]",
              "name": "Gross Margin",
              "format": {
                "kind": "number",
                "formatString": ",.2f"
              }
            },
            {
              "id": "AAAAAAAAA4",
              "formula": "([Gross Margin]) / NullIf(([Sales Amount]), 0)",
              "name": "GM %",
              "format": {
                "kind": "number",
                "formatString": ",.1%"
              }
            },
            {
              "id": "AAAAAAAAA5",
              "formula": "CountDistinct([Order Number])",
              "name": "Orders",
              "format": {
                "kind": "number",
                "formatString": ",.0f"
              }
            },
            {
              "id": "AAAAAAAAA6",
              "formula": "([Sales Amount]) / NullIf(([Units]), 0)",
              "name": "Avg Price",
              "format": {
                "kind": "number",
                "formatString": ",.2f"
              }
            }
          ],
