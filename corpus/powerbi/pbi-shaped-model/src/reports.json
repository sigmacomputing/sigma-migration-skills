 "calcTables": {
  "Cover Bucket": {
   "columns": [
    [
     "Bucket",
     "string"
    ],
    [
     "Min Days",
     "int64"
    ],
    [
     "Max Days",
     "int64"
    ],
    [
     "Sort",
     "int64"
    ]
   ],
   "sortBy": {
    "Bucket": "Sort"
   },
   "expression": "DATATABLE(\"Bucket\", STRING, \"Min Days\", INTEGER, \"Max Days\", INTEGER, \"Sort\", INTEGER, {{\"Under 7 days\", 0, 7, 1}, {\"7 to 14 days\", 7, 14, 2}, {\"14 to 28 days\", 14, 28, 3}, {\"28 days or more\", 28, 100000, 4}})"
  }
 },
 "measureSets": {
  "sales": {
   "Sales": [
    [
     "Sales Amount",
     "SUMX(Sales, Sales[Quantity] * Sales[Unit Price] * (1 - Sales[Discount]))",
     "#,0.00",
     "Sales"
    ],
    [
     "Units",
     "SUM(Sales[Quantity])",
     "#,0",
     "Sales"
    ],
    [
     "Cost",
     "SUMX(Sales, Sales[Quantity] * Sales[Unit Cost])",
     "#,0.00",
     "Sales"
    ],
    [
     "Gross Margin",
     "[Sales Amount] - [Cost]",
     "#,0.00",
     "Sales"
    ],
    [
     "GM %",
     "DIVIDE([Gross Margin], [Sales Amount])",
     "0.0%",
     "Sales"
    ],
    [
     "Orders",
     "DISTINCTCOUNT(Sales[Order Number])",
     "#,0",
     "Sales"
    ],
    [
     "Avg Price",
     "DIVIDE([Sales Amount], Sales[Units])",
     "#,0.00",
     "Sales"
    ],
    [
     "List Value",
     "SUMX(Sales, Sales[Quantity] * RELATED(Product[List Price]))",
     "#,0.00",
     "Product"
    ],
    [
     "Private Label Sales",
     "CALCULATE([Sales Amount], Product[Private Label] = TRUE())",
     "#,0.00",
     "Product"
    ],
    [
     "Sales by Ship Date",
     "CALCULATE([Sales Amount], USERELATIONSHIP(Sales[ShipDateKey], 'Date'[DateKey]))",
     "#,0.00",
     "Shipping"
    ],
    [
     "Sales YTD",
     "TOTALYTD([Sales Amount], 'Date'[Date])",
     "#,0.00",
     "Time"
    ],
    [
     "Sales QTD",
     "TOTALQTD([Sales Amount], 'Date'[Date])",
     "#,0.00",
     "Time"
    ],
    [
     "Sales MTD",
     "TOTALMTD([Sales Amount], 'Date'[Date])",
     "#,0.00",
     "Time"
    ],
    [
     "Sales PY",
     "CALCULATE([Sales Amount], SAMEPERIODLASTYEAR('Date'[Date]))",
     "#,0.00",
     "Time"
    ],
    [
     "Sales YoY %",
     "DIVIDE([Sales Amount] - [Sales PY], [Sales PY])",
     "0.0%",
     "Time"
    ],
    [
     "Sales R28",
     "CALCULATE([Sales Amount], DATESINPERIOD('Date'[Date], MAX('Date'[Date]), -28, DAY))",
     "#,0.00",
     "Time"
    ],
    [
     "Sales YTD (As Of)",
     "VAR asof = MAX('As Of'[As Of Date]) RETURN CALCULATE([Sales Amount], DATESBETWEEN('Date'[Date], DATE(YEAR(asof), 1, 1), asof))",
     "#,0.00",
     "Time"
    ]
   ]
  },
  "inventory": {
   "Inventory": [
    [
     "On Hand (Latest)",
     "VAR d = CALCULATE(MAX(Inventory[DateKey]), ALL(Inventory)) RETURN CALCULATE(SUM(Inventory[Units]), Inventory[DateKey] = d)",
     "#,0",
     "Inventory"
    ],
    [
     "Open PO Units",
     "CALCULATE(SUMX('Purchase Orders', 'Purchase Orders'[Ordered Units] - 'Purchase Orders'[Received Units]), 'Purchase Orders'[Status] = \"Open\")",
     "#,0",
     "Inventory"
    ],
    [
     "Sales R28 Units",
     "CALCULATE(SUM(Sales[Quantity]), DATESINPERIOD('Date'[Date], MAX('Date'[Date]), -28, DAY))",
     "#,0",
     "Inventory"
    ],
    [
     "Days of Cover",
     "DIVIDE([On Hand (Latest)], DIVIDE([Sales R28 Units], 28))",
     "#,0.0",
     "Inventory"
    ],
    [
     "Products by Cover Bucket",
     "VAR lo = MIN('Cover Bucket'[Min Days]) VAR hi = MAX('Cover Bucket'[Max Days]) RETURN COUNTROWS(FILTER(VALUES(Product[ProductKey]), VAR c = [Days of Cover] RETURN NOT ISBLANK(c) && c >= lo && c < hi))",
     "#,0",
     "Inventory"
    ]
   ]
  },
  "rls": {
   "Store": [
    [
     "Store Count",
     "COUNTROWS(Store)",
     "#,0",
     "Counts"
    ]
   ],
   "Customer": [
    [
     "Customer Count",
     "COUNTROWS(Customer)",
     "#,0",
     "Counts"
    ]
   ]
  }
 },
