      {
        "name": "Sales",
        "columns": [
          {
            "name": "SalesLineKey",
            "dataType": "int64",
            "sourceColumn": "SALES_LINE_KEY",
            "summarizeBy": "none"
          },
          {
            "name": "Order Number",
            "dataType": "string",
            "sourceColumn": "ORDER_NUMBER",
            "summarizeBy": "none"
          },
          {
            "name": "OrderDateKey",
            "dataType": "int64",
            "sourceColumn": "ORDER_DATE_KEY",
            "summarizeBy": "none"
          },
          {
            "name": "ShipDateKey",
            "dataType": "int64",
            "sourceColumn": "SHIP_DATE_KEY",
            "summarizeBy": "none"
          },
          {
            "name": "SkuKey",
            "dataType": "int64",
            "sourceColumn": "SKU_KEY",
            "summarizeBy": "none"
          },
          {
            "name": "CustomerKey",
            "dataType": "int64",
            "sourceColumn": "CUSTOMER_KEY",
            "summarizeBy": "none"
          },
          {
            "name": "StoreKey",
            "dataType": "int64",
            "sourceColumn": "STORE_KEY",
            "summarizeBy": "none"
          },
          {
            "name": "Quantity",
            "dataType": "int64",
            "sourceColumn": "QUANTITY",
            "summarizeBy": "sum",
            "formatString": "#,0"
          },
          {
            "name": "Unit Price",
            "dataType": "double",
            "sourceColumn": "UNIT_PRICE",
            "summarizeBy": "none",
            "formatString": "#,0.00"
          },
          {
            "name": "Discount",
            "dataType": "double",
            "sourceColumn": "DISCOUNT",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "Unit Cost",
            "dataType": "double",
            "sourceColumn": "UNIT_COST",
            "summarizeBy": "none",
            "formatString": "#,0.00"
          }
        ],
        "partitions": [
          {
            "name": "Sales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Source = Snowflake.Databases(\"example-account.snowflakecomputing.com\", \"EXAMPLE_WH\", [Role = null, CreateNavigationProperties = null, ConnectionTimeout = null, CommandTimeout = null, Implementation = \"2.0\"]),",
                "  #\"Navigation 1\" = Source{[Name = \"SAMPLE_DB\", Kind = \"Database\"]}[Data],",
                "  #\"Navigation 2\" = #\"Navigation 1\"{[Name = \"ZZ_CLAUDE_PBI_SHAPED\", Kind = \"Schema\"]}[Data],",
                "  #\"Navigation 3\" = #\"Navigation 2\"{[Name = \"FACT_SALES\", Kind = \"Table\"]}[Data]",
                "in",
                "  #\"Navigation 3\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Sales Amount",
            "expression": "SUMX(Sales, Sales[Quantity] * Sales[Unit Price] * (1 - Sales[Discount]))",
            "formatString": "#,0.00",
            "displayFolder": "Sales"
          },
          {
            "name": "Units",
            "expression": "SUM(Sales[Quantity])",
            "formatString": "#,0",
            "displayFolder": "Sales"
          },
          {
            "name": "Cost",
            "expression": "SUMX(Sales, Sales[Quantity] * Sales[Unit Cost])",
            "formatString": "#,0.00",
            "displayFolder": "Sales"
          },
          {
            "name": "Gross Margin",
            "expression": "[Sales Amount] - [Cost]",
            "formatString": "#,0.00",
            "displayFolder": "Sales"
          },
          {
            "name": "GM %",
            "expression": "DIVIDE([Gross Margin], [Sales Amount])",
            "formatString": "0.0%",
            "displayFolder": "Sales"
          },
          {
            "name": "Orders",
            "expression": "DISTINCTCOUNT(Sales[Order Number])",
            "formatString": "#,0",
            "displayFolder": "Sales"
          },
          {
            "name": "Avg Price",
            "expression": "DIVIDE([Sales Amount], Sales[Units])",
            "formatString": "#,0.00",
            "displayFolder": "Sales"
          },
          {
            "name": "List Value",
            "expression": "SUMX(Sales, Sales[Quantity] * RELATED(Product[List Price]))",
            "formatString": "#,0.00",
            "displayFolder": "Product"
          },
          {
            "name": "Private Label Sales",
            "expression": "CALCULATE([Sales Amount], Product[Private Label] = TRUE())",
            "formatString": "#,0.00",
            "displayFolder": "Product"
          },
          {
            "name": "Sales by Ship Date",
            "expression": "CALCULATE([Sales Amount], USERELATIONSHIP(Sales[ShipDateKey], 'Date'[DateKey]))",
            "formatString": "#,0.00",
            "displayFolder": "Shipping"
          },
          {
            "name": "Sales YTD",
            "expression": "TOTALYTD([Sales Amount], 'Date'[Date])",
            "formatString": "#,0.00",
            "displayFolder": "Time"
          },
          {
            "name": "Sales QTD",
            "expression": "TOTALQTD([Sales Amount], 'Date'[Date])",
            "formatString": "#,0.00",
            "displayFolder": "Time"
          },
          {
            "name": "Sales MTD",
            "expression": "TOTALMTD([Sales Amount], 'Date'[Date])",
            "formatString": "#,0.00",
            "displayFolder": "Time"
          },
          {
            "name": "Sales PY",
            "expression": "CALCULATE([Sales Amount], SAMEPERIODLASTYEAR('Date'[Date]))",
            "formatString": "#,0.00",
            "displayFolder": "Time"
          },
          {
            "name": "Sales YoY %",
            "expression": "DIVIDE([Sales Amount] - [Sales PY], [Sales PY])",
            "formatString": "0.0%",
            "displayFolder": "Time"
          },
          {
            "name": "Sales R28",
            "expression": "CALCULATE([Sales Amount], DATESINPERIOD('Date'[Date], MAX('Date'[Date]), -28, DAY))",
            "formatString": "#,0.00",
            "displayFolder": "Time"
          },
          {
            "name": "Sales YTD (As Of)",
            "expression": "VAR asof = MAX('As Of'[As Of Date]) RETURN CALCULATE([Sales Amount], DATESBETWEEN('Date'[Date], DATE(YEAR(asof), 1, 1), asof))",
            "formatString": "#,0.00",
            "displayFolder": "Time"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "Sales_OrderDate",
        "fromTable": "Sales",
        "fromColumn": "OrderDateKey",
        "toTable": "Date",
