        "toColumn": "DateKey",
        "isActive": false
      },
      {
        "name": "Sales_SKU",
        "fromTable": "Sales",
        "fromColumn": "SkuKey",
        "toTable": "SKU",
        "toColumn": "SkuKey"
      },
      {
        "name": "Sales_Customer",
        "fromTable": "Sales",
        "fromColumn": "CustomerKey",
        "toTable": "Customer",
        "toColumn": "CustomerKey"
      },
      {
        "name": "Sales_Store",
        "fromTable": "Sales",
        "fromColumn": "StoreKey",
        "toTable": "Store",
        "toColumn": "StoreKey"
      },
      {
        "name": "SKU_Product",
        "fromTable": "SKU",
        "fromColumn": "ProductKey",
        "toTable": "Product",
        "toColumn": "ProductKey"
      },
      {
        "name": "Product_Category",
        "fromTable": "Product",
        "fromColumn": "CategoryKey",
        "toTable": "Category",
        "toColumn": "CategoryKey"
      },
      {
        "name": "Product_Vendor",
        "fromTable": "Product",
        "fromColumn": "VendorKey",
        "toTable": "Vendor",
        "toColumn": "VendorKey"
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Date\", \"As Of\", \"Category\", \"Vendor\", \"Product\", \"SKU\", \"Customer\", \"Store\", \"Sales\"]"
      }
    ]
  }
}