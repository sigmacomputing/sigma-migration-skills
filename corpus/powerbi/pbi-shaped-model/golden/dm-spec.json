          "metrics": [
            {
              "id": "id0079",
              "formula": "Sum(Coalesce([Quantity], 0) * Coalesce([Unit Price], 0) * (1 - Coalesce([Discount], 0)))",
              "name": "Sales Amount",
              "format": {
                "kind": "number",
                "formatString": ",.2f"
              },
              "description": "Power BI display folder: Sales"
            },
            {
              "id": "id0080",
              "formula": "Sum([Quantity])",
              "name": "Units",
              "format": {
                "kind": "number",
                "formatString": ",.0f"
              },
              "description": "Power BI display folder: Sales"
            },
            {
              "id": "id0081",
              "formula": "Sum([Quantity] * [Unit Cost])",
              "name": "Cost",
              "format": {
                "kind": "number",
                "formatString": ",.2f"
              },
              "description": "Power BI display folder: Sales"
            },
            {
              "id": "id0082",
              "formula": "If(IsNull([Metrics/Sales Amount]) and IsNull([Metrics/Cost]), Null, Coalesce([Metrics/Sales Amount], 0) - Coalesce([Metrics/Cost], 0))",
              "name": "Gross Margin",
              "format": {
                "kind": "number",
                "formatString": ",.2f"
              },
              "description": "Power BI display folder: Sales"
            },
            {
              "id": "id0083",
              "formula": "([Metrics/Gross Margin]) / NullIf(([Metrics/Sales Amount]), 0)",
              "name": "GM %",
              "format": {
                "kind": "number",
                "formatString": ",.1%"
              },
              "description": "Power BI display folder: Sales"
            },
            {
              "id": "id0084",
              "formula": "CountDistinct([Order Number])",
              "name": "Orders",
              "format": {
                "kind": "number",
                "formatString": ",.0f"
              },
              "description": "Power BI display folder: Sales"
            },
            {
              "id": "id0085",
              "formula": "([Metrics/Sales Amount]) / NullIf(([Metrics/Units]), 0)",
              "name": "Avg Price",
              "format": {
                "kind": "number",
                "formatString": ",.2f"
              },
              "description": "Power BI display folder: Sales"
            },
            {
              "id": "id0086",
              "name": "List Value",
              "formula": "Sum([Quantity] * [List Price (Product)])",
              "description": "Power BI display folder: Product"
            },
            {
              "id": "id0087",
              "name": "Private Label Sales",
              "formula": "SumIf(Coalesce([Quantity], 0) * Coalesce([Unit Price], 0) * (1 - Coalesce([Discount], 0)), [Private Label (Product)] = True)",
              "format": {
                "kind": "number",
                "formatString": ",.2f"
              },
              "description": "Power BI's CALCULATE filter on Private Label overrides slicers on that column; in Sigma a slicer on Private Label still applies. Power BI display folder: Product"
            },
            {
              "id": "id0088",
              "name": "Sales by Ship Date",
              "formula": "Sum(Coalesce([Quantity], 0) * Coalesce([Unit Price], 0) * (1 - Coalesce([Discount], 0)))",
              "format": {
                "kind": "number",
                "formatString": ",.2f"
              },
              "description": "Power BI display folder: Shipping"
            },
            {
              "id": "id0089",
              "name": "Sales YTD (As Of)",
              "formula": "SumIf(Coalesce([Quantity], 0) * Coalesce([Unit Price], 0) * (1 - Coalesce([Discount], 0)), [Date (Date)] >= DateTrunc(\"year\", [As Of Date]) and [Date (Date)] <= [As Of Date])",
              "description": "Reproduces Power BI measure Sales[Sales YTD (As Of)]: YTD anchored on As Of[As Of Date]. Power BI display folder: Time",
              "format": {
                "kind": "number",
                "formatString": ",.2f"
              }
            }
          ],
          "filters": [
            {
              "id": "id0090",
              "columnId": "id0070",
              "kind": "text-match",
              "mode": "does-not-equal",
              "value": "Discontinued",
              "case": "insensitive",
              "includeNulls": "always"
            }
          ],
          "description": "Power BI table Sales, with the metrics. Related values come in through Lookup(): ProductKey (SKU), List Price (Product), Private Label (Product), CategoryKey (Product), Category Name (Category), Date (Date), As Of Date."
        },
        {
          "id": "id0091",
          "kind": "table",
          "name": "Sales – rolling 28 days by day",
          "description": "Generated for Power BI measures: Sales[Sales R28]. One row per calendar day of Date (a dense spine), each window summing the trailing 28 days from the start of the history. Sigma's MovingSum counts rows, not days, so it is not used. Segment, Store Region, Customer Region carried: one window per value. Read a window at the latest day in scope (Sum(If([Day] = Max([Day]), [col], Null))).",
          "source": {
            "kind": "sql",
            "connectionId": "00000000-0000-0000-0000-000000000000",
            "statement": "WITH pbi_fact AS (\nSELECT * FROM \"SAMPLE_DB\".\"ZZ_CLAUDE_PBI_SHAPED\".\"FACT_SALES\"\n), pbi_dates AS (\nSELECT * FROM \"SAMPLE_DB\".\"ZZ_CLAUDE_PBI_SHAPED\".\"DIM_DATE\"\n), pbi_combos AS (\n  SELECT DISTINCT cd0.\"SEGMENT\" AS \"Segment\", cd1.\"STORE_REGION\" AS \"Store Region\", cd0.\"CUSTOMER_REGION\" AS \"Customer Region\"\n  FROM pbi_fact f LEFT JOIN (\nSELECT * FROM \"SAMPLE_DB\".\"ZZ_CLAUDE_PBI_SHAPED\".\"DIM_CUSTOMER\"\n) cd0 ON cd0.\"CUSTOMER_KEY\" = f.\"CUSTOMER_KEY\" LEFT JOIN (\nSELECT * FROM \"SAMPLE_DB\".\"ZZ_CLAUDE_PBI_SHAPED\".\"DIM_STORE\"\n) cd1 ON cd1.\"STORE_KEY\" = f.\"STORE_KEY\"\n), pbi_daily AS (\n  SELECT dd.\"CAL_DATE\" AS \"DAY\", cd0.\"SEGMENT\" AS \"Segment\", cd1.\"STORE_REGION\" AS \"Store Region\", cd0.\"CUSTOMER_REGION\" AS \"Customer Region\", SUM(COALESCE(f.\"QUANTITY\", 0) * COALESCE(f.\"UNIT_PRICE\", 0) * (1 - COALESCE(f.\"DISCOUNT\", 0))) AS \"SALES_R28\"\n  FROM pbi_fact f JOIN pbi_dates dd ON dd.\"DATE_KEY\" = f.\"ORDER_DATE_KEY\" LEFT JOIN (\nSELECT * FROM \"SAMPLE_DB\".\"ZZ_CLAUDE_PBI_SHAPED\".\"DIM_CUSTOMER\"\n) cd0 ON cd0.\"CUSTOMER_KEY\" = f.\"CUSTOMER_KEY\" LEFT JOIN (\nSELECT * FROM \"SAMPLE_DB\".\"ZZ_CLAUDE_PBI_SHAPED\".\"DIM_STORE\"\n) cd1 ON cd1.\"STORE_KEY\" = f.\"STORE_KEY\"\n  WHERE 1 = 1\n    AND NOT COALESCE(f.\"SKU_KEY\" IN (SELECT k1.\"SKU_KEY\" FROM (\nSELECT * FROM \"SAMPLE_DB\".\"ZZ_CLAUDE_PBI_SHAPED\".\"DIM_SKU\"\n) k1 WHERE k1.\"PRODUCT_KEY\" IN (SELECT k2.\"PRODUCT_KEY\" FROM (\nSELECT * FROM \"SAMPLE_DB\".\"ZZ_CLAUDE_PBI_SHAPED\".\"DIM_PRODUCT\"\n) k2 WHERE k2.\"CATEGORY_KEY\" IN (SELECT k3.\"CATEGORY_KEY\" FROM (\nSELECT * FROM \"SAMPLE_DB\".\"ZZ_CLAUDE_PBI_SHAPED\".\"DIM_CATEGORY\"\n) k3 WHERE LOWER(k3.\"CATEGORY_NAME\") IN ('discontinued')))), FALSE) /*@slicers fact=\"Sales\" alias=\"f\"*/\n  GROUP BY dd.\"CAL_DATE\", cd0.\"SEGMENT\", cd1.\"STORE_REGION\", cd0.\"CUSTOMER_REGION\"\n)\nSELECT spine.\"CAL_DATE\" AS \"DAY\", spine.\"Segment\" AS \"Segment\", spine.\"Store Region\" AS \"Store Region\", spine.\"Customer Region\" AS \"Customer Region\", CASE WHEN COUNT(daily.\"SALES_R28\") OVER (PARTITION BY spine.\"Segment\", spine.\"Store Region\", spine.\"Customer Region\" ORDER BY spine.\"CAL_DATE\" ROWS BETWEEN 27 PRECEDING AND CURRENT ROW) = 0 THEN NULL ELSE SUM(COALESCE(daily.\"SALES_R28\", 0)) OVER (PARTITION BY spine.\"Segment\", spine.\"Store Region\", spine.\"Customer Region\" ORDER BY spine.\"CAL_DATE\" ROWS BETWEEN 27 PRECEDING AND CURRENT ROW) END AS \"SALES_R28\"\nFROM (SELECT d.\"CAL_DATE\", c.\"Segment\", c.\"Store Region\", c.\"Customer Region\" FROM pbi_dates d CROSS JOIN pbi_combos c) spine\nLEFT JOIN pbi_daily daily ON daily.\"DAY\" = spine.\"CAL_DATE\" AND (daily.\"Segment\" = spine.\"Segment\" OR (daily.\"Segment\" IS NULL AND spine.\"Segment\" IS NULL)) AND (daily.\"Store Region\" = spine.\"Store Region\" OR (daily.\"Store Region\" IS NULL AND spine.\"Store Region\" IS NULL)) AND (daily.\"Customer Region\" = spine.\"Customer Region\" OR (daily.\"Customer Region\" IS NULL AND spine.\"Customer Region\" IS NULL))"
          },
