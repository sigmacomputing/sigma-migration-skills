{
  "pages": [
    {
      "name": "Quick Pct Across Region",
      "elements": [
        {
          "id": "title-text-quick-pct-across-region",
          "kind": "text",
          "body": "## Quick Pct Across Region"
        },
        {
          "id": "el-quick-pct-across-region",
          "kind": "pivot-table",
          "name": "Quick Pct Across Region",
          "source": {
            "kind": "table",
            "elementId": "master"
          },
          "columns": [
            {
              "id": "p-el-quick-pct-across-region-row-segment",
              "name": "Segment",
              "formula": "[Master/Segment]"
            },
            {
              "id": "p-el-quick-pct-across-region-col-region",
              "name": "Region",
              "formula": "[Master/Region]"
            },
            {
              "id": "p-el-quick-pct-across-region-value-sum-sales",
              "name": "sum:Sales",
              "formula": "PercentOfTotal(Sum([Master/Sales]), \"row\")",
              "format": {
                "kind": "number",
                "formatString": ",.0f",
                "displayNullAs": ""
              }
            },
            {
              "id": "p-el-quick-pct-across-region-col-region-nullfirst",
              "name": "Region (null-first sort)",
              "formula": "If(IsNull([Master/Region]), \"\", [Master/Region])"
            }
          ],
          "values": [
            "p-el-quick-pct-across-region-value-sum-sales"
          ],
          "rowsBy": [
            {
              "columnId": "p-el-quick-pct-across-region-row-segment"
            }
          ],
          "columnsBy": [
            {
              "columnId": "p-el-quick-pct-across-region-col-region",
              "sort": {
                "direction": "ascending",
                "by": "p-el-quick-pct-across-region-col-region-nullfirst",
                "aggregation": "min"
              }
            }
          ],
          "totals": {
            "showGrandTotals": "hidden",
            "showSubtotals": "when-collapsed"
          },
          "display": {
            "headerWidths": {
              "uniformWidth": 65
            }
          }
        }
      ]
    },
