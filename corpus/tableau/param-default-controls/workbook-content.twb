<?xml version='1.0' encoding='utf-8'?>
<workbook source-build='2024.1.0 (20241.24.0114.1153)' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
  </preferences>
  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column caption='Region Pick' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;West&quot;'>
        <calculation class='tableau' formula='&quot;East&quot;' />
        <members>
          <member value='&quot;East&quot;' />
          <member alias='Western' value='&quot;West&quot;' />
          <member value='&quot;North&quot;' />
        </members>
      </column>
      <column caption='As Of Date' datatype='date' name='[Parameter 2]' param-domain-type='all' role='measure' type='quantitative' value='#2024-06-01#'>
        <calculation class='tableau' formula='#2024-06-01#' />
      </column>
      <column caption='Top Limit' datatype='integer' name='[Parameter 3]' param-domain-type='all' role='measure' type='quantitative' value='25'>
        <calculation class='tableau' formula='25' />
      </column>
      <column caption='Name Match' datatype='string' name='[Parameter 4]' param-domain-type='all' role='measure' type='nominal' value='&quot;ACME&quot;'>
        <calculation class='tableau' formula='&quot;ACME&quot;' />
      </column>
      <column caption='Rate Band' datatype='real' name='[Parameter 5]' param-domain-type='range' role='measure' type='quantitative'>
        <range granularity='0.1' max='1.0' min='0.0' />
      </column>
      <column caption='Cutoff Date' datatype='date' name='[Parameter 6]' param-domain-type='all' role='measure' type='quantitative'>
      </column>
    </datasource>
    <datasource caption='Orders Small' inline='true' name='federated.0abc123demo456' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='example.snowflakecomputing.com' name='snowflake.0demo1'>
            <connection authentication='username-password' class='snowflake' dbname='DEMO_DB' schema='DEMO' server='example.snowflakecomputing.com' service='' username='svc_demo' warehouse='DEMO_WH' />
          </named-connection>
        </named-connections>
        <relation connection='snowflake.0demo1' name='ORDERS_SMALL' table='[DEMO].[ORDERS_SMALL]' type='table' />
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>ORDER_ID</remote-name>
            <remote-type>20</remote-type>
            <local-name>[ORDER_ID]</local-name>
            <parent-name>[ORDERS_SMALL]</parent-name>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>NET_REVENUE</remote-name>
            <remote-type>5</remote-type>
            <local-name>[NET_REVENUE]</local-name>
            <parent-name>[ORDERS_SMALL]</parent-name>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>REGION_NAME</remote-name>
            <remote-type>129</remote-type>
            <local-name>[REGION_NAME]</local-name>
            <parent-name>[ORDERS_SMALL]</parent-name>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
          </metadata-record>
        </metadata-records>
      </connection>
      <column caption='Order Id' datatype='integer' name='[ORDER_ID]' role='dimension' type='ordinal' />
      <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
      <column caption='Region Name' datatype='string' name='[REGION_NAME]' role='dimension' type='nominal' />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Overview'>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders Small' name='federated.0abc123demo456' />
          </datasources>
          <datasource-dependencies datasource='federated.0abc123demo456'>
            <column caption='Net Revenue' datatype='real' name='[NET_REVENUE]' role='measure' type='quantitative' />
            <column-instance column='[NET_REVENUE]' derivation='Sum' name='[sum:NET_REVENUE:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings />
          </pane>
        </panes>
        <rows>[federated.0abc123demo456].[sum:NET_REVENUE:qk]</rows>
        <cols />
      </table>
    </worksheet>
  </worksheets>
  <windows>
    <window class='worksheet' name='Overview'>
      <cards />
    </window>
  </windows>
</workbook>
