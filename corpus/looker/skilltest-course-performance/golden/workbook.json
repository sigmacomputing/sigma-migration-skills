          },
          "columns": [
            {
              "id": "id0022",
              "formula": "If([looker-param-enrollment-metrics-time-grain] = \"week\", DateTrunc(\"week\", [Data/Period Date]), DateTrunc(\"month\", [Data/Period Date]))",
              "name": "Selected Period"
            },
            {
              "id": "id0023",
              "formula": "If([looker-param-enrollment-metrics-group-by] = \"country_group\", [Data/Country Group], [Data/Content Domain])",
              "name": "Selected Group"
            },
            {
              "id": "id0024",
              "formula": "If([looker-param-enrollment-metrics-funnel-metric] = \"m1_rate\", 1.0 * [Data/Module 1 Completions] / NullIf([Data/Enrollments], 0), If([looker-param-enrollment-metrics-funnel-metric] = \"f30d\", [Data/Active Days 30], If([looker-param-enrollment-metrics-funnel-metric] = \"completion_rate\", 1.0 * [Data/Course Completions] / NullIf([Data/Enrollments], 0), If([looker-param-enrollment-metrics-funnel-metric] = \"conversion_rate\", 1.0 * [Data/Freemium Conversions] / NullIf([Data/Enrollments], 0), [Data/Enrollments]))))",
              "name": "Selected Metric"
