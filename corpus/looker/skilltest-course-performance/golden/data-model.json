  "dynamicParameters": [
    {
      "view": "enrollment_metrics",
      "name": "funnel_metric",
      "type": "unquoted",
      "defaultValue": "enrollments",
      "allowedValues": [
        {
          "label": "Enrollments",
          "value": "enrollments"
        },
        {
          "label": "Module 1 Completion Rate",
          "value": "m1_rate"
        },
        {
          "label": "F30D",
          "value": "f30d"
        },
        {
          "label": "Course Completion Rate",
          "value": "completion_rate"
        },
        {
          "label": "Freemium Conversion Rate",
          "value": "conversion_rate"
        }
      ],
      "affectedFields": [
        {
          "field": "enrollment_metrics.selected_metric",
          "label": "Selected Funnel Metric",
          "kind": "dimension",
          "sourceSql": "{% if funnel_metric._parameter_value == 'm1_rate' %}\n        1.0 * ${TABLE}.module_1_completions / NULLIF(${TABLE}.enrollments, 0)\n      {% elsif funnel_metric._parameter_value == 'f30d' %}\n        ${TABLE}.active_days_30\n      {% elsif funnel_metric._parameter_value == 'completion_rate' %}\n        1.0 * ${TABLE}.course_completions / NULLIF(${TABLE}.enrollments, 0)\n      {% elsif funnel_metric._parameter_value == 'conversion_rate' %}\n        1.0 * ${TABLE}.freemium_conversions / NULLIF(${TABLE}.enrollments, 0)\n      {% else %}\n        ${TABLE}.enrollments\n      {% endif %}",
          "branches": {
            "enrollments": "${TABLE}.enrollments",
            "m1_rate": "1.0 * ${TABLE}.module_1_completions / NULLIF(${TABLE}.enrollments, 0)",
            "f30d": "${TABLE}.active_days_30",
            "completion_rate": "1.0 * ${TABLE}.course_completions / NULLIF(${TABLE}.enrollments, 0)",
            "conversion_rate": "1.0 * ${TABLE}.freemium_conversions / NULLIF(${TABLE}.enrollments, 0)"
          },
          "deterministic": true
        }
      ]
    },
    {
      "view": "enrollment_metrics",
      "name": "group_by",
      "type": "unquoted",
      "defaultValue": "content_domain",
      "allowedValues": [
        {
          "label": "Content Domain",
          "value": "content_domain"
        },
        {
          "label": "Country Group",
          "value": "country_group"
        }
      ],
      "affectedFields": [
        {
          "field": "enrollment_metrics.selected_group",
          "label": "Selected Group",
          "kind": "dimension",
          "sourceSql": "{% if group_by._parameter_value == 'country_group' %}\n        ${TABLE}.country_group\n      {% else %}\n        ${TABLE}.content_domain\n      {% endif %}",
          "branches": {
            "content_domain": "${TABLE}.content_domain",
            "country_group": "${TABLE}.country_group"
          },
          "deterministic": true
        }
      ]
    },
    {
      "view": "enrollment_metrics",
      "name": "time_grain",
      "type": "unquoted",
      "defaultValue": "month",
      "allowedValues": [
        {
          "label": "Month",
          "value": "month"
        },
        {
          "label": "Week",
          "value": "week"
        }
      ],
      "affectedFields": [
        {
          "field": "enrollment_metrics.selected_period",
          "label": "Selected Period",
          "kind": "dimension",
          "sourceSql": "{% if time_grain._parameter_value == 'week' %}\n        DATE_TRUNC('WEEK', ${TABLE}.period_date)\n      {% else %}\n        DATE_TRUNC('MONTH', ${TABLE}.period_date)\n      {% endif %}",
          "branches": {
            "month": "DATE_TRUNC('MONTH', ${TABLE}.period_date)",
            "week": "DATE_TRUNC('WEEK', ${TABLE}.period_date)"
          },
          "deterministic": true
        }
      ]
    }
  ]
