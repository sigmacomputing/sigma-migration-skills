            "kind": "table",
            "name": "Period Bridge",
            "source": {
              "connectionId": "fixture",
              "statement": "SELECT\n        period_date,\n        content_domain,\n        SUM(enrollments) AS period_enrollments,\n        LAG(SUM(enrollments)) OVER (\n          PARTITION BY content_domain\n          ORDER BY period_date\n        ) AS prior_period_enrollments\n      FROM FIXTURE.COURSE_FUNNEL\n      GROUP BY period_date, content_domain",
              "kind": "sql"
            },
            "columns": [
              {
                "id": "id0003",
                "formula": "[Custom SQL/PERIOD_DATE]",
                "name": "Period Date"
              },
              {
                "id": "id0004",
                "formula": "[Custom SQL/CONTENT_DOMAIN]",
                "name": "Content Domain"
              },
              {
                "id": "id0005",
                "formula": "[Custom SQL/PERIOD_ENROLLMENTS]",
                "name": "Period Enrollments"
              },
              {
                "id": "id0006",
                "formula": "[Custom SQL/PRIOR_PERIOD_ENROLLMENTS]",
                "name": "Prior Period Enrollments"
              }
            ],
            "order": [
              "id0003",
              "id0004",
              "id0005",
              "id0006"
            ]
          },
          {
            "id": "id0007",
            "kind": "table",
            "name": "Enrollment Metrics",
            "source": {
              "connectionId": "fixture",
              "statement": "SELECT\n        period_date,\n        content_domain,\n        country_group,\n        SUM(enrollments) AS enrollments,\n        SUM(module_1_completions) AS module_1_completions,\n        SUM(course_completions) AS course_completions,\n        SUM(freemium_conversions) AS freemium_conversions,\n        AVG(active_days_30) AS active_days_30,\n        MAX(overall_revenue_rank) AS overall_revenue_rank\n      FROM FIXTURE.COURSE_FUNNEL\n      GROUP BY period_date, content_domain, country_group",
              "kind": "sql"
            },
            "columns": [
              {
